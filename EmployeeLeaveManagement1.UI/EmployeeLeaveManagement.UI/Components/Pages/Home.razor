@page "/"

<PageTitle>Employee Leave Management</PageTitle>

<div class="dashboard">

    <!-- Welcome Banner -->
    <section class="welcome-banner">

        <div>
            <p class="welcome-small">WELCOME BACK</p>

            <h1>Employee Leave Management</h1>

            <p class="welcome-description">
                Manage employees, leave types, and leave requests easily
                from one simple dashboard.
            </p>
        </div>

        <div class="welcome-icon">
            📅
        </div>

    </section>


    <!-- Dashboard Cards -->
    <section class="dashboard-cards">

        <a href="/employees" class="dashboard-card employees-card">

            <div class="card-icon">
                👥
            </div>

            <h3>Employees</h3>

            <p>
                View and manage employee details.
            </p>

            <span class="card-arrow">→</span>

        </a>


        <a href= "/employees/add" class="dashboard-card add-card">

            <div class="card-icon">
                ➕
            </div>

            <h3>Add Employee</h3>

            <p>
                Add a new employee to the system.
            </p>

            <span class="card-arrow">→</span>

        </a>


        <a href="/leave-types" class="dashboard-card types-card">

            <div class="card-icon">
                📋
            </div>

            <h3>Leave Types</h3>

            <p>
                View and manage available leave types.
            </p>

            <span class="card-arrow">→</span>

        </a>


        <a href="/leave/apply" class="dashboard-card apply-card">

            <div class="card-icon">
                📝
            </div>

            <h3>Apply Leave</h3>

            <p>
                Submit a new employee leave request.
            </p>

            <span class="card-arrow">→</span>

        </a>


        <a href="/leave-requests" class="dashboard-card requests-card">

            <div class="card-icon">
                📅
            </div>

            <h3>Leave Requests</h3>

            <p>
                View and manage employee leave requests.
            </p>

            <span class="card-arrow">→</span>

        </a>

    </section>


    <!-- Workflow -->
    <section class="overview-section">

        <div class="section-heading">

            <div class="section-heading-icon">
                🔄
            </div>

            <div>
                <h2>Leave Management Workflow</h2>

                <p>
                    Simple process for managing employee leaves.
                </p>
            </div>

        </div>


        <div class="workflow-list">

            <div class="workflow-item">
                <span>01</span>
                <strong>Add Employee</strong>
                <p>Create employee records.</p>
            </div>

            <div class="workflow-item">
                <span>02</span>
                <strong>Define Leave Types</strong>
                <p>Manage available leave types.</p>
            </div>

            <div class="workflow-item">
                <span>03</span>
                <strong>Apply Leave</strong>
                <p>Submit employee leave requests.</p>
            </div>

            <div class="workflow-item">
                <span>04</span>
                <strong>Manage Requests</strong>
                <p>Review and manage requests.</p>
            </div>

        </div>

    </section>


    <!-- Quick Actions -->
    <section class="quick-section">

        <div class="section-heading">

            <div class="section-heading-icon">
                ⚡
            </div>

            <div>
                <h2>Quick Actions</h2>

                <p>
                    Frequently used employee management actions.
                </p>
            </div>

        </div>


        <div class="quick-actions">

            <a href="/employees" class="quick-action-button">

                <span>👥</span>

                <div>
                    <strong>Manage Employees</strong>
                    <small>View all employees</small>
                </div>

                <b>→</b>

            </a>


            <a href="/leave-types" class="quick-action-button">

                <span>📋</span>

                <div>
                    <strong>Manage Leave Types</strong>
                    <small>View available leave types</small>
                </div>

                <b>→</b>

            </a>


            <a href="/leave-requests" class="quick-action-button">

                <span>📅</span>

                <div>
                    <strong>Manage Leave Requests</strong>
                    <small>Review employee requests</small>
                </div>

                <b>→</b>

            </a>

        </div>

    </section>


    <!-- Bottom Features -->
    <section class="bottom-features">

        <div>
            <span>🔐</span>

            <div>
                <strong>Secure Management</strong>
                <p>Employee information is organized securely.</p>
            </div>
        </div>


        <div>
            <span>⚡</span>

            <div>
                <strong>Easy Workflow</strong>
                <p>Manage employees and leaves efficiently.</p>
            </div>
        </div>


        <div>
            <span>📊</span>

            <div>
                <strong>Centralized System</strong>
                <p>All employee leave information in one place.</p>
            </div>
        </div>

    </section>

</div>
