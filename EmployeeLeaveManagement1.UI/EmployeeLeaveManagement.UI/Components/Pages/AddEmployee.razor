@page "/employees/add"
@rendermode InteractiveServer

@using EmployeeLeaveManagement.UI.Models
@using EmployeeLeaveManagement.UI.Services

@inject EmployeeService EmployeeService
@inject NavigationManager Navigation

<h3>Add Employee</h3>

<EditForm Model="@employee"
          OnValidSubmit="@SaveEmployee"
          FormName="AddEmployeeForm"
          Enhance="false">

    <div class="mb-3">
        <label>First Name</label>
        <InputText class="form-control"
                   @bind-Value="employee.FirstName" />
    </div>

    <div class="mb-3">
        <label>Last Name</label>
        <InputText class="form-control"
                   @bind-Value="employee.LastName" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control"
                   @bind-Value="employee.Email" />
    </div>

    <div class="mb-3">
        <label>Joining Date</label>
        <InputDate class="form-control"
                   @bind-Value="employee.JoiningDate" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save Employee
    </button>

</EditForm>

@if (!string.IsNullOrEmpty(message))
{
    <p class="mt-3">@message</p>
}

@code {
    private CreateEmployeeDto employee = new()
        {
            JoiningDate = DateTime.Today
        };

    private string message = "";

    private async Task SaveEmployee()
    {
        try
        {
            var success = await EmployeeService.CreateEmployeeAsync(employee);

            if (success)
            {
                Navigation.NavigateTo("/employees");
            }
            else
            {
                message = "Failed to add employee.";
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }
}