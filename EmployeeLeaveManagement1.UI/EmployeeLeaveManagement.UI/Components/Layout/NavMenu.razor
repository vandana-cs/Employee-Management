@rendermode InteractiveServer
@using EmployeeLeaveManagement.UI.Authentication

@inject AuthService AuthService
@inject NavigationManager NavigationManager

<div class="sidebar-brand">
    <div class="brand-logo">📅</div>

    <div class="brand-text">
        Employee Leave
        <br />
        Management
    </div>
</div>

<nav class="sidebar-navigation">

    <NavLink class="sidebar-link" href="/" Match="NavLinkMatch.All">
        <span class="sidebar-link-icon">🏠</span>
        <span>Home</span>
    </NavLink>

    @if (AuthService.IsAdmin() || AuthService.IsHR())
    {
        <NavLink class="sidebar-link" href="/employees">
            <span class="sidebar-link-icon">👥</span>
            <span>Employees</span>
        </NavLink>

        <NavLink class="sidebar-link" href="/employees/add">
            <span class="sidebar-link-icon">➕</span>
            <span>Add Employee</span>
        </NavLink>

        <NavLink class="sidebar-link" href="/leave-types">
            <span class="sidebar-link-icon">📋</span>
            <span>Leave Types</span>
        </NavLink>

        <NavLink class="sidebar-link" href="/leave-requests">
            <span class="sidebar-link-icon">🗓️</span>
            <span>Leave Requests</span>
        </NavLink>

        <NavLink class="sidebar-link" href="/leave-balance">
            <span class="sidebar-link-icon">💰</span>
            <span>Leave Balance</span>
        </NavLink>

        <NavLink class="sidebar-link" href="/employee-status">
            <span class="sidebar-link-icon">👤</span>
            <span>Employee Status</span>
        </NavLink>
    }

    @if (AuthService.IsEmployee())
    {
        <NavLink class="sidebar-link" href="/leave/apply">
            <span class="sidebar-link-icon">📝</span>
            <span>Apply Leave</span>
        </NavLink>

        <NavLink class="sidebar-link" href="/leave-requests">
            <span class="sidebar-link-icon">🗓️</span>
            <span>My Leave Requests</span>
        </NavLink>

        <NavLink class="sidebar-link" href="/leave-balance">
            <span class="sidebar-link-icon">💰</span>
            <span>My Leave Balance</span>
        </NavLink>
    }

    <button class="sidebar-link"
            type="button"
            @onclick="Logout">

        <span class="sidebar-link-icon">🚪</span>
        <span>Logout</span>

    </button>

</nav>

<div class="sidebar-footer">

    <div class="footer-leaf">🌿</div>

    <p>
        Better People.<br />
        Better Workplaces.
    </p>

</div>

@code
{
    private void Logout()
    {
        AuthService.Logout();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}